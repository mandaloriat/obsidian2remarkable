# obsidian2remarkable – environment configuration example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required ────────────────────────────────────────────────────
# Absolute path to your Obsidian vault
VAULT_PATH=/home/user/Documents/MyVault

# ── Optional ────────────────────────────────────────────────────
# Directory where generated PDFs are cached
# OUTPUT_DIR=.remarkable-export/out

# Directory where the reMarkable device token is stored
# CREDENTIALS_DIR=.credentials

# Folder name to create in the reMarkable Cloud
# REMARKABLE_FOLDER=Obsidian

# Prefix added to every PDF filename
# PDF_PREFIX=Obsidian - 

# Inbox subdirectory inside the vault (relative to VAULT_PATH)
# INBOX_DIR=remarkable-inbox

# Set to "true" to export every Markdown note in the vault
# SCAN_ALL_VAULT=false

# Set to "false" to disable scanning vault for remarkable:true frontmatter
# SCAN_FRONTMATTER=true

# Path to Pandoc binary (if not on PATH)
# PANDOC_BIN=pandoc

# Pandoc PDF engine: pdflatex, xelatex, lualatex, weasyprint, ...
# You can also point this to a binary path, e.g. .venv-weasyprint/bin/weasyprint
# PANDOC_PDF_ENGINE=xelatex

# Page geometry string passed to Pandoc
# PAGE_GEOMETRY=a4paper,top=2cm,bottom=2cm,left=2.5cm,right=2.5cm

# Base font size for PDFs
# FONT_SIZE=11pt

# Upload retry settings
# MAX_RETRIES=3
# RETRY_DELAY_MS=2000

# Watch mode timing
# WATCH_DEBOUNCE_MS=2000
# WATCH_COOLDOWN_MS=0

# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info
